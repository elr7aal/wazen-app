# Runtime mode: development | production
WAZEN_ENV=development

# Local PostgreSQL example. Production must use persistent PostgreSQL.
DATABASE_URL=postgresql+psycopg://wazen:wazen@localhost:5432/wazen

# Use a unique secret of at least 32 characters. Never use the development default in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Admin console authentication.
WAZEN_ADMIN_KEY=replace-with-a-separate-admin-secret

# Explicit comma-separated origins are required when WAZEN_ENV=production.
WAZEN_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Session / password reset policy.
WAZEN_REFRESH_DAYS=30
WAZEN_RESET_MINUTES=30
WAZEN_PASSWORD_RESET_DELIVERY=NOT_CONFIGURED
WAZEN_PASSWORD_RESET_DEBUG=false

# Optional: enables real food image analysis.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-astra
